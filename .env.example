# DeepSeek Proxy 配置示例
# 复制为 .env 并填入你的值

# 认证模式: token (默认) 或 password
DS_AUTH_MODE=token

# === Token 模式 ===
# 从浏览器 F12 获取 Bearer Token
DS_TOKEN=

# === Password 模式 ===
DS_EMAIL=
DS_MOBILE=
DS_AREA_CODE=
DS_PASSWORD=

# 会话策略: reuse (默认) 或 new
DS_SESSION_MODE=reuse

# 服务器
DS_HOST=127.0.0.1
DS_PORT=5317

# API Key 鉴权 (逗号分隔，留空=不鉴权)
DS_API_TOKENS=
